# Quasar AI Runtime - 构建与运行产物
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# 测试与缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 运行期数据（向量库、SQLite、trace、评测报告）
# 用 data/* 而不是 data/ —— 目录整体被排除后 git 不会进入该目录，
# 后面的 !data/.gitkeep 会失效。写成 data/* 才能反选占位文件，
# 保证干净 checkout 里 data/ 目录存在（pytest --basetemp 依赖它）。
data/*
!data/.gitkeep
*.db
*.sqlite3
*.npz
*.jsonl
!docs/**/*.jsonl

# 本地配置与密钥
.env
.env.*
!.env.example
configs/local.toml

# 本地调试 / 探针产物
data-online/
data-verify-debug/
.recon/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
